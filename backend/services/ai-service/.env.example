# ===== Application =====
APP_NAME="ArkNexus AI Service"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ===== API Server =====
API_HOST=0.0.0.0
API_PORT=8001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data/ai_service.db

# ===== Auth (must match the gateway / email-service) =====
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256

# ===== Config Service =====
CONFIG_SERVICE_URL=http://127.0.0.1:8081
CONFIG_SERVICE_REGISTER_ON_STARTUP=true
CONFIG_SERVICE_HEARTBEAT_INTERVAL_SECONDS=60

# ===== Chat defaults =====
MAX_PROMPT_TOKENS_HARD_LIMIT=200000
MAX_CONVERSATION_MESSAGES=200
DEFAULT_STREAM=true
UPSTREAM_TIMEOUT_SECONDS=120
