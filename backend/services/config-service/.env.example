# ===== Application =====
APP_NAME="ArkNexus Config Service"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ===== API Server =====
API_HOST=0.0.0.0
API_PORT=8081
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data/config_service.db

# ===== Auth =====
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== Heartbeat =====
SERVICE_HEARTBEAT_TIMEOUT_SECONDS=90
