# ===== Application =====
APP_NAME="ArkNexus Email Service"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ===== API Server =====
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== SMTP Receiver (aiosmtpd) =====
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=
SMTP_BANNER_HOSTNAME=

# ===== Email Domain =====
EMAIL_DOMAIN=arknexus.local
EMAIL_LOCALPART_MAX_LEN=40

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data/email_service.db

# ===== Storage =====
ATTACHMENT_DIR=./data/attachments
MAX_ATTACHMENT_SIZE_MB=25
MAX_MESSAGE_SIZE_MB=30

# ===== Outbound (receive-only service; no relay in this phase) =====

# ===== Retention =====
RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=1

# ===== Config Service integration (optional) =====
CONFIG_SERVICE_URL=http://127.0.0.1:8081
CONFIG_SERVICE_REGISTER_ON_STARTUP=true
CONFIG_SERVICE_HEARTBEAT_INTERVAL_SECONDS=60
CONFIG_SERVICE_PULL_INTERVAL_SECONDS=120

# ===== Auth =====
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== OAuth (optional) =====
# Public URL where the backend is reachable from the browser (used to
# build the OAuth redirect_uri). Use the gateway for typical dev setups.
OAUTH_REDIRECT_BASE=http://127.0.0.1:8080
# Sign cookies for OAuth state. Override in production.
OAUTH_STATE_SECRET=change-me-oauth-state

# GitHub OAuth App: https://github.com/settings/developers
# Authorized callback URL: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
