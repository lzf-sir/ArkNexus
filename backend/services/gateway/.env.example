# ===== Gateway settings =====
GATEWAY_NAME="ArkNexus Gateway"
APP_ENV=development
LOG_LEVEL=INFO

# Bind address / port
API_HOST=0.0.0.0
API_PORT=8080
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Upstream services =====
EMAIL_SERVICE_URL=http://127.0.0.1:8000
CONFIG_SERVICE_URL=http://127.0.0.1:8081
AI_SERVICE_URL=http://127.0.0.1:8001

# ===== Auth =====
# Must match the email-service JWT_SECRET so the gateway can introspect tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256

# When true the gateway rejects unauthenticated requests for non-public paths.
REQUIRE_AUTH_FOR_PROTECTED=true
# Comma-separated list of prefixes that bypass JWT validation.
PUBLIC_PATH_PREFIXES=/api/v1/auth/login,/api/v1/auth/register,/api/v1/system/stats,/api/v1/system/health
