# ===== Application =====
APP_NAME="ArkNexus Email Service"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ===== API Server =====
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== SMTP Receiver (aiosmtpd) =====
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=
SMTP_BANNER_HOSTNAME=

# ===== Email Domain =====
EMAIL_DOMAIN=arknexus.local
EMAIL_LOCALPART_MAX_LEN=40

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data/email_service.db

# ===== Storage =====
ATTACHMENT_DIR=./data/attachments
MAX_ATTACHMENT_SIZE_MB=25
MAX_MESSAGE_SIZE_MB=30

# ===== SMTP Sender (Relay) =====
SMTP_RELAY_MODE=console
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_USE_TLS=true
SMTP_RELAY_HELO=arknexus.local

# ===== Retention =====
RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=1

# ===== Config Service integration (optional) =====
CONFIG_SERVICE_URL=
CONFIG_SERVICE_REGISTER_ON_STARTUP=true
CONFIG_SERVICE_HEARTBEAT_INTERVAL_SECONDS=60
CONFIG_SERVICE_PULL_INTERVAL_SECONDS=120

# ===== Auth =====
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== OAuth (optional) =====
OAUTH_REDIRECT_BASE=http://127.0.0.1:8080
OAUTH_STATE_SECRET=change-me-oauth-state
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Microsoft Identity Platform v2.0 (Azure AD + personal accounts)
# 应用注册: https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# 重定向 URI: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/microsoft/callback
# 支持的租户策略:
#   common        - 工作/学校 + 个人账号 (默认)
#   organizations - 仅工作/学校
#   consumers     - 仅个人 Microsoft 账号
#   <tenant-guid> - 锁定到单个 Azure AD 租户
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
