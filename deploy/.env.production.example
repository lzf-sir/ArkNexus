# .env.production — secrets consumed by docker-compose.production.yml.
#
# Generate strong secrets with: openssl rand -base64 48
# After editing, deploy with:
#   docker compose -f deploy/docker-compose.production.yml \
#       --env-file deploy/.env.production up -d
#
# Do NOT commit this file. .gitignore already excludes it.

# === Core ===
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
OAUTH_STATE_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# === Public URLs (used for OAuth redirect_uri) ===
OAUTH_REDIRECT_BASE=https://api.example.com
CORS_ORIGINS=https://arknexus.example.com,https://www.arknexus.example.com

# === OAuth providers (leave blank to disable) ===
# GitHub: https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Microsoft: https://entra.microsoft.com → App registrations
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# === JWT lifetime ===
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Cloudflare Tunnel ===
# 1. cloudflared tunnel login            # one-time
# 2. cloudflared tunnel create arknexus  # creates a tunnel, prints UUID
# 3. Place the JSON credentials at deploy/cloudflared/<UUID>.json
# 4. Copy the token from `cloudflared tunnel token <UUID>` output
CLOUDFLARE_TUNNEL_TOKEN=
