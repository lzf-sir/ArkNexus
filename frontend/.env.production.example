# Production environment variables for the frontend.
#
# Copy this file to `.env.production` and fill in real values before running
# `npm run build`. Cloudflare Pages reads its own env vars from the dashboard
# (Settings → Environment variables), so `.env.production` is only used for
# local production-mode builds or for the Wrangler CLI deploy.

# Base URL for backend API calls. MUST end with /api/v1 and be HTTPS.
# When deploying via Cloudflare Pages, set this in the dashboard under
# "VITE_API_BASE_URL". For local production builds:
VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional: product name override (shown in header / login page).
# VITE_APP_NAME=ArkNexus
